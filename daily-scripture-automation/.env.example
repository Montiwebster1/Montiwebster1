# Copy this file to .env and fill in real values. Never commit .env.
TZ=America/Chicago
SOURCE_URL=https://wol.jw.org/en/wol/d/r1/lp-e/1102026216
RECIPIENT_EMAIL=montiwebster@gmail.com

# --- Text-to-speech ---
# Leave TTS_PROVIDER blank (or set to "local") to use the built-in offline
# engine (pyttsx3 + eSpeak-ng) — no key required, produces .wav.
# Set to "elevenlabs" or "openai" to use a cloud provider (requires TTS_API_KEY).
TTS_PROVIDER=
TTS_API_KEY=
TTS_VOICE_ID=

# --- Email delivery ---
# EMAIL_PROVIDER=gmail_oauth  (preferred) or  smtp
EMAIL_PROVIDER=
EMAIL_FROM=

# Gmail OAuth (create an OAuth client in Google Cloud Console, run the
# one-time authorization flow to obtain a refresh token)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# SMTP (e.g. a Gmail "App Password", or any other SMTP provider)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- ChatGPT "Journal - My Children" project handoff ---
# api     -> use an official project-session API (not currently available; falls back to queue)
# browser -> authenticated Playwright automation using an existing persistent profile
# queue   -> (default) save the structured entry to output/journal-handoff/ for manual submission
CHATGPT_HANDOFF_METHOD=queue
CHATGPT_PROJECT_NAME=Journal - My Children
CHATGPT_BROWSER_PROFILE_PATH=
